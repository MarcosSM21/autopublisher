# Environment files (only templates such as .env.example are versioned)
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-journal

# User data and runtime directories (private media lives here)
data/
media/
uploads/

# Logs
*.log
logs/

# Caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.tsbuildinfo

# Dependencies
.venv/
node_modules/

# Builds and coverage reports
dist/
build/
coverage/
htmlcov/

# Temporary and editor files
*.tmp
*.swp
.DS_Store
.idea/
.vscode/

# Secrets and credentials
*.pem
*.key
secrets.*
credentials*.json
client_secret*.json
google-oauth-client*.json
instagram-app*.json
threads-app*.json
tiktok-app*.json
telegram-app*.json
meta-app*.json
media-delivery*.json
*token*.json
# Telegram session files (sessions live only in the secure credential storage)
*.session
*.session-journal

# Third-party design skill (UI UX Pro Max v2.15.0): local tooling only, never versioned
.claude/skills/ui-ux-pro-max/
